---
import BaseLayout from '../layouts/BaseLayout.astro';

const services = [
    ['01', '가정용 가스 공급', '일반 가정용 LPG를 안전하게 공급합니다.'],
    ['02', '업소용 가스 공급', '음식점과 공장 등 사업장에 필요한 가스를 공급합니다.'],
    ['03', '의료용 가스 공급', '병원과 의료기관에 의료용 산소 등을 공급합니다.'],
    ['04', '산업용 가스 공급', '산소, 알곤, 헬륨, 탄산 등 산업용 가스를 취급합니다.'],
    ['05', '배달 서비스', '전화 한 통으로 필요한 현장에 신속하게 배달합니다.'],
    ['06', '설치 및 점검', '전문 기사가 안전하게 설치하고 정기 점검을 지원합니다.']
];
---
<BaseLayout
    title="회사소개 - 신항만 가스 | 부산, 경남 가스 공급 전문"
    description="신항만 가스는 부산, 경남(거제, 창원, 마산, 진해) 지역에서 산업용, 의료용, 특수가스, 액체가스를 공급하는 전문 업체입니다. 안전하고 신속한 서비스."
    keywords="신항만가스 회사소개, 부산가스업체, 경남가스, 산소가스공급, 질소가스, 아르곤, 의료용산소, 부산사하구가스"
    ogTitle="회사소개 - 신항만 가스"
    ogDescription="부산, 경남 지역 가스 공급 전문 업체. 산업용, 의료용, 특수가스 전문."
    ogImage="https://sinhangman-gas.onrender.com/images/truck-1.jpeg"
    ogUrl="https://sinhangman-gas.onrender.com/about"
>
    <section class="page-header">
        <div class="container">
            <p class="section-kicker">/ ABOUT</p>
            <h1>회사소개</h1>
            <p>부산·경남 가스 공급 전문업체입니다.</p>
        </div>
    </section>

    <section class="content-section">
        <div class="container about-content">
            <div class="split-heading">
                <div>
                    <p class="section-kicker">/ WHO WE ARE</p>
                    <h2>안전한 가스 공급</h2>
                </div>
                <p class="lead">가정용 LPG와 업소용·의료용·산업용 가스를 취급합니다. 지역사회 공급망을 안정적으로 운영합니다.</p>
            </div>

            <div class="about-image-section">
                <img src="/images/truck-1.jpeg" alt="신항만 가스 배달 차량" class="about-main-img">
            </div>

            <div class="detail-grid">
                <article>
                    <p class="section-kicker">VISION</p>
                    <h3>우리의 비전</h3>
                    <p>안전 공급과 빠른 대응으로 신뢰를 만듭니다.</p>
                </article>
                <article>
                    <p class="section-kicker">AREA</p>
                    <h3>서비스 지역</h3>
                    <p>부산·경남 주요 지역에 공급 상담을 제공합니다.</p>
                </article>
            </div>

            <div class="service-list linear-list">
                {services.map(([no, title, desc]) => (
                    <article class="service-item linear-item reveal-item">
                        <span>{no}</span>
                        <h3>{title}</h3>
                        <p>{desc}</p>
                    </article>
                ))}
            </div>

            <div class="about-images-layout">
                <div class="about-images-top">
                    <img src="/images/truck-1.jpeg" alt="배달 차량" class="about-grid-img">
                    <img src="/images/truck-2.jpeg" alt="서비스 차량" class="about-grid-img">
                </div>
                <div class="about-images-bottom">
                    <img src="/images/work-1.jpeg" alt="전문 작업" class="about-work-img">
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
