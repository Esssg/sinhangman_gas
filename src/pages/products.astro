---
import BaseLayout from '../layouts/BaseLayout.astro';

const categories = [
    {
        no: '01',
        title: '산업용 가스',
        desc: '용접, 절단, 불활성 보호, 냉각 등 산업 현장 필수 가스',
        products: ['산소 (O2)', '질소 (N2)', '아르곤 (Ar)', '이산화탄소 (CO2)', '헬륨 (He)', '수소 (H2)']
    },
    {
        no: '02',
        title: '의료용 가스',
        desc: '병원 및 의료기관 운영에 필요한 전문 가스',
        products: ['의료용 산소 (O2)', '의료용 질소 (N2)', '탄산 (CO2)', '아산화질소 (N2O)', 'EO가스']
    },
    {
        no: '03',
        title: '특수가스',
        desc: '고순도, 혼합, 표준, 연구 및 전자 산업용 가스',
        products: ['고순도 가스', '혼합 가스', '표준 가스', '연구용 가스', '전자 산업용']
    },
    {
        no: '04',
        title: '액체가스',
        desc: '초저온 액체가스와 대용량 공급 상담',
        products: ['액체산소 (LOX)', '액체아르곤 (LAr)', '액화질소 (LN2)', '액화탄산 (LCO2)', '대용량 공급']
    }
];

const support = [
    ['설치 서비스', '신규 설치, 교체 설치, 안전 점검을 전문 기사와 함께 진행합니다.'],
    ['정기 배달 서비스', '사용량과 일정에 맞춘 정기 배달 계약을 상담합니다.'],
    ['안전 점검 서비스', '가스 누출, 배관 상태, 사용 환경을 정기적으로 확인합니다.']
];
---
<BaseLayout
    title="제품 및 서비스 - 신항만 가스 | 산소, 질소, 아르곤, 헬륨 등 모든 가스"
    description="산업용가스(산소, 질소, 아르곤, 헬륨, 수소), 의료용가스(의료용산소, 아산화질소), 특수가스, 액체가스(액화질소, 액체아르곤) 전문. 부산, 경남 지역 배달."
    keywords="산소가스, 질소가스, 아르곤가스, 헬륨가스, 수소가스, 의료용산소, 액화질소, 액체아르곤, 산업용가스, 특수가스, 부산산소, 경남가스배달, 가스판매"
    ogTitle="제품 및 서비스 - 신항만 가스"
    ogDescription="산소, 질소, 아르곤, 헬륨 등 모든 가스 공급. 산업용, 의료용, 특수가스 전문."
    ogImage="https://sinhangman-gas.onrender.com/images/lpg-10kg.jpg"
    ogUrl="https://sinhangman-gas.onrender.com/products"
>
    <section class="page-header">
        <div class="container">
            <p class="section-kicker">/ PRODUCTS</p>
            <h1>제품 및 서비스</h1>
            <p>산업용, 의료용, 특수가스, 액체가스 품목 안내입니다.</p>
        </div>
    </section>

    <section class="content-section">
        <div class="container products-grid-gas">
            {categories.map((category) => (
                <article class="product-category-card reveal-item">
                    <button class="category-header" type="button" onclick="toggleCategory(this)" aria-expanded="false">
                        <span>{category.no}</span>
                        <h3>{category.title}</h3>
                        <span class="dropdown-arrow">+</span>
                    </button>
                    <div class="category-content">
                        <p class="category-desc">{category.desc}</p>
                        <div class="sub-products">
                            {category.products.map((product) => (
                                <div class="sub-product-item">
                                    <img src="/images/lpg-10kg.jpg" alt={product} class="sub-product-img">
                                    <h4>{product}</h4>
                                </div>
                            ))}
                        </div>
                        <a href="tel:010-5513-3481" class="btn-order">전화 주문</a>
                    </div>
                </article>
            ))}
        </div>

        <div class="container">
            <div class="split-heading">
                <div>
                    <p class="section-kicker">/ SUPPORT</p>
                    <h2 class="section-title">부가 서비스</h2>
                </div>
            </div>
            <div class="products-grid-services">
                {support.map(([title, desc]) => (
                    <article class="product-card reveal-item">
                        <h3>{title}</h3>
                        <p>{desc}</p>
                        <a href="tel:010-5513-3481" class="btn-order">전화 문의</a>
                    </article>
                ))}
            </div>

            <div class="info-box">
                <p class="section-kicker">/ ORDER</p>
                <h3>주문 및 문의</h3>
                <p class="phone-large">010-5513-3481</p>
                <p>평일 07:30 - 17:30, 토요일 07:30 - 13:00</p>
            </div>
        </div>
    </section>
</BaseLayout>
