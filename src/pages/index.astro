---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
---
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>신항만 가스 - 믿을 수 있는 가스 공급 업체</title>
    <meta name="naver-site-verification" content="24bc4e237b199acd7b996ca6d0b7e4c974a71474" />
    <meta name="description" content="부산 사하구 신항만가스. 산업용가스(산소, 질소, 아르곤, 헬륨, 수소), 의료용가스, 특수가스, 액체가스 전문. 부산, 경남, 거제, 창원, 마산, 진해 배달 가능. 010-5513-3481">
    <meta name="keywords" content="신항만가스, 부산가스, 사하구가스, 신평동가스, 산소가스, 질소가스, 아르곤가스, 헬륨가스, 수소가스, 의료용산소, 산업용가스, 특수가스, 액체가스, 액화질소, 부산산소, 경남가스, 거제가스, 창원가스, 마산가스, 진해가스, LPG, 가스배달, 가스공급">
    <meta property="og:type" content="website">
    <meta property="og:title" content="신항만 가스 - 믿을 수 있는 가스 공급 업체">
    <meta property="og:description" content="부산, 경남 지역 최고의 가스 공급 업체. 산업용, 의료용, 특수가스, 액체가스 전문. 신속한 배달과 안전한 서비스.">
    <meta property="og:url" content="https://sinhangman-gas.onrender.com">
    <meta property="og:image" content="https://sinhangman-gas.onrender.com/images/gas-cylinder-1.jpg">
    <meta property="og:locale" content="ko_KR">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="신항만 가스 - 믿을 수 있는 가스 공급 업체">
    <meta name="twitter:description" content="부산, 경남 지역 최고의 가스 공급 업체">
    <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "신항만 가스",
      "alternateName": "신항만가스",
      "description": "부산, 경남 지역 산업용, 의료용, 특수가스, 액체가스 전문 공급업체",
      "image": "https://sinhangman-gas.onrender.com/images/gas-cylinder-1.jpg",
      "telephone": "010-5513-3481",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "을숙도대로677번길 11",
        "addressLocality": "신평동",
        "addressRegion": "사하구",
        "addressCountry": "부산광역시"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": "35.0861315",
        "longitude": "128.9790935"
      },
      "url": "https://sinhangman-gas.onrender.com",
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "07:30",
          "closes": "17:30"
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": "Saturday",
          "opens": "07:30",
          "closes": "13:00"
        }
      ],
      "areaServed": [
        {
          "@type": "City",
          "name": "부산광역시"
        },
        {
          "@type": "AdministrativeArea",
          "name": "경상남도"
        }
      ],
      "priceRange": "$$",
      "paymentAccepted": "현금, 계좌이체",
      "currenciesAccepted": "KRW"
    }
    </script>
    <link rel="icon" type="image/png" href="/images/logo-simple.png">
    <link rel="apple-touch-icon" href="/images/logo-simple.png">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <link rel="stylesheet" href="/css/style.css">
    <noscript>
        <style>
            #intro-animation { display: none !important; }
            #main-content { opacity: 1 !important; }
            .hero.bg-ready::before { opacity: 0.2 !important; }
        </style>
    </noscript>
    <script is:inline>
        (function() {
            var ua = navigator.userAgent || navigator.vendor || window.opera;
            var isInApp = (ua.indexOf('KAKAOTALK') > -1 ||
                          ua.indexOf('NAVER') > -1 ||
                          ua.indexOf('Instagram') > -1 ||
                          ua.indexOf('FB') > -1 ||
                          ua.indexOf('Line') > -1);
            if (isInApp) {
                document.documentElement.classList.add('skip-intro');
                var style = document.createElement('style');
                style.innerHTML = '#intro-animation, .intro-container, .intro-image-container, .intro-text-container, .intro-image { display: none !important; position: absolute !important; left: -9999px !important; width: 0 !important; height: 0 !important; } #main-content { opacity: 1 !important; } body { overflow: auto !important; }';
                document.head.appendChild(style);
            }
        })();
    </script>
    <style id="inapp-override">
        @media all {
            html.skip-intro #intro-animation,
            html.skip-intro .intro-animation,
            html.skip-intro .intro-container,
            html.skip-intro .intro-image-container,
            html.skip-intro .intro-text-container,
            html.skip-intro .intro-image,
            body.skip-intro #intro-animation,
            body.skip-intro .intro-animation,
            body.skip-intro .intro-container,
            body.skip-intro .intro-image-container,
            body.skip-intro .intro-text-container,
            body.skip-intro .intro-image {
                display: none !important;
                visibility: hidden !important;
                opacity: 0 !important;
                position: absolute !important;
                left: -9999px !important;
                top: -9999px !important;
                z-index: -9999 !important;
                width: 0 !important;
                height: 0 !important;
                max-width: 0 !important;
                max-height: 0 !important;
                overflow: hidden !important;
            }

            html.skip-intro #main-content,
            body.skip-intro #main-content {
                opacity: 1 !important;
                visibility: visible !important;
                position: static !important;
            }

            html.skip-intro header .logo img,
            body.skip-intro header .logo img {
                height: 26px !important;
                max-width: 85px !important;
            }

            html.skip-intro body,
            body.skip-intro {
                overflow: auto !important;
            }
        }
    </style>
</head>
<body>
    <div id="intro-animation" class="intro-container">
        <div class="intro-text-container">
            <p class="intro-subtitle"></p>
            <h1 class="intro-title"></h1>
        </div>
        <div class="intro-image-container">
            <img src="/images/gas-cylinder-1.jpg" alt="신항만가스" class="intro-image">
        </div>
    </div>

    <div id="main-content" class="main-content-wrapper">
        <Navigation />

        <section class="hero" id="hero">
            <div class="hero-content">
                <h2>안전하고 신뢰할 수 있는</h2>
                <h1>신항만 가스</h1>
                <p>부산, 경남 지역 최고의 가스 공급 업체</p>
                <a href="tel:010-5513-3481" class="btn-primary">지금 문의하기</a>
            </div>
        </section>

        <div class="scroll-indicator" id="scrollIndicator">
            <div class="scroll-circle">
                <span>Scroll</span>
                <div class="scroll-arrow">↓</div>
            </div>
        </div>

        <section class="services">
            <div class="container">
                <h2>주요 서비스</h2>
                <div class="service-grid">
                    <div class="service-card">
                        <div class="service-icon">🏠</div>
                        <h3>가정용 가스</h3>
                        <p>안전한 가정용 LPG 공급</p>
                        <p class="service-desc">일상 생활에 필요한 가스를 안전하고 신속하게 공급해드립니다.</p>
                    </div>
                    <div class="service-card">
                        <div class="service-icon">🏢</div>
                        <h3>업소용 가스</h3>
                        <p>음식점, 사업장 대량 공급</p>
                        <p class="service-desc">음식점, 공장 등 대량 사용처에 안정적으로 공급합니다.</p>
                    </div>
                    <div class="service-card">
                        <div class="service-icon">🏥</div>
                        <h3>의료용 가스</h3>
                        <p>병원 및 의료기관 전문 공급</p>
                        <p class="service-desc">의료용 산소 등 의료기관에 필요한 가스를 전문적으로 공급합니다.</p>
                    </div>
                    <div class="service-card">
                        <div class="service-icon">🏭</div>
                        <h3>산업용 가스</h3>
                        <p>공장 및 산업 현장 공급</p>
                        <p class="service-desc">산업 현장에서 필요한 각종 산업용 가스를 공급합니다.</p>
                    </div>
                    <div class="service-card">
                        <div class="service-icon">🚚</div>
                        <h3>배달 서비스</h3>
                        <p>신속하고 정확한 배달</p>
                        <p class="service-desc">전화 한 통이면 빠르게 배달해드립니다.</p>
                    </div>
                    <div class="service-card">
                        <div class="service-icon">🔧</div>
                        <h3>설치 및 점검</h3>
                        <p>전문 기사의 안전 점검</p>
                        <p class="service-desc">정기적인 안전 점검으로 안심하고 사용하실 수 있습니다.</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="gallery-section">
            <div class="container">
                <h2>신항만 가스 현장</h2>
                <p class="section-desc">안전하고 신속한 서비스를 제공하는 신항만 가스의 모습입니다</p>
                <div class="gallery-grid">
                    <div class="gallery-item">
                        <img src="/images/factory-1.jpeg" alt="신항만 가스 저장소">
                        <div class="gallery-overlay"><p>가스 저장 시설</p></div>
                    </div>
                    <div class="gallery-item">
                        <img src="/images/truck-1.jpeg" alt="배달 차량">
                        <div class="gallery-overlay"><p>배달 차량</p></div>
                    </div>
                    <div class="gallery-item">
                        <img src="/images/work-1.jpeg" alt="작업 현장">
                        <div class="gallery-overlay"><p>전문 작업</p></div>
                    </div>
                    <div class="gallery-item">
                        <img src="/images/factory-2.jpeg" alt="시설 전경">
                        <div class="gallery-overlay"><p>시설 전경</p></div>
                    </div>
                    <div class="gallery-item">
                        <img src="/images/truck-2.jpeg" alt="배송 서비스">
                        <div class="gallery-overlay"><p>신속 배송</p></div>
                    </div>
                    <div class="gallery-item">
                        <img src="/images/factory-3.jpeg" alt="안전 시설">
                        <div class="gallery-overlay"><p>안전 관리</p></div>
                    </div>
                </div>
            </div>
        </section>

        <section class="why-choose-us">
            <div class="container">
                <h2>왜 신항만 가스인가?</h2>
                <div class="features">
                    <div class="feature">
                        <h3>✓ 안전성</h3>
                        <p>엄격한 안전 기준과 정기적인 점검</p>
                    </div>
                    <div class="feature">
                        <h3>✓ 신속성</h3>
                        <p>빠른 배달과 즉각적인 대응</p>
                    </div>
                    <div class="feature">
                        <h3>✓ 신뢰성</h3>
                        <p>지역 밀착형 서비스로 오랜 신뢰</p>
                    </div>
                    <div class="feature">
                        <h3>✓ 전문성</h3>
                        <p>숙련된 전문 인력의 서비스</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="contact">
            <div class="container">
                <h2>연락처</h2>
                <div class="contact-info">
                    <div class="contact-item">
                        <h3>📞 전화</h3>
                        <p><a href="tel:010-5513-3481">010-5513-3481</a></p>
                    </div>
                    <div class="contact-item">
                        <h3>📍 주소</h3>
                        <p>부산 사하구 을숙도대로677번길 11</p>
                        <p class="address-sub">(부산 사하구 신평동 568-4)</p>
                    </div>
                    <div class="contact-item">
                        <h3>🕐 영업시간</h3>
                        <p>평일 07:30 - 17:30</p>
                        <p>토요일 07:30 - 13:00</p>
                        <p>일요일 및 공휴일 휴무</p>
                    </div>
                </div>
                <div class="cta-buttons">
                    <a href="tel:010-5513-3481" class="btn-secondary">전화 문의하기</a>
                    <a href="/location" class="btn-secondary">오시는 길 보기</a>
                </div>
            </div>
        </section>

        <Footer />
    </div>

    <script src="/js/main.js" is:inline></script>
</body>
</html>
