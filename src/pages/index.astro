---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

const metrics = [
    { value: '07:30', label: '평일 영업 시작' },
    { value: '부산·경남', label: '주요 공급 지역' },
    { value: '산업·의료·특수', label: '취급 가스 범위' },
    { value: '010-5513-3481', label: '즉시 문의' }
];

const services = [
    ['01', '산업용 가스', '산업 현장에 필요한 주요 가스를 안정적으로 공급합니다.'],
    ['02', '의료용 가스', '의료용 산소와 관련 가스를 전문적으로 취급합니다.'],
    ['03', '특수가스', '고순도, 혼합, 연구용 가스를 용도에 맞춰 안내합니다.'],
    ['04', '액체가스', '액화질소와 액체아르곤 등 액체가스 공급을 상담합니다.'],
    ['05', '정기 배달', '사업장 사용량과 일정에 맞춰 정기배달을 지원합니다.'],
    ['06', '설치 및 점검', '사용 환경에 맞춰 설치, 교체, 정기점검을 제공합니다.']
];

const strengths = [
    ['1', '안전 기준 중심', '보관, 이동, 설치 과정에서 안전 기준을 우선으로 확인합니다.'],
    ['2', '지역 밀착 대응', '부산 사하구를 중심으로 부산 전역과 경남 주요 지역에 대응합니다.'],
    ['3', '현장 이해도', '가정, 업소, 산업 현장의 사용 환경에 맞춰 필요한 가스를 안내합니다.'],
    ['4', '빠른 연락 동선', '전화 한 번으로 제품, 배달, 점검 상담까지 바로 연결됩니다.']
];
---
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>신항만 가스 - 믿을 수 있는 가스 공급 업체</title>
    <meta name="naver-site-verification" content="24bc4e237b199acd7b996ca6d0b7e4c974a71474" />
    <meta name="description" content="부산 사하구 신항만가스. 산업용가스(산소, 질소, 아르곤, 헬륨, 수소), 의료용가스, 특수가스, 액체가스 전문. 부산, 경남, 거제, 창원, 마산, 진해 배달 가능. 010-5513-3481">
    <meta name="keywords" content="신항만가스, 부산가스, 사하구가스, 신평동가스, 산소가스, 질소가스, 아르곤가스, 헬륨가스, 수소가스, 의료용산소, 산업용가스, 특수가스, 액체가스, 액화질소, 부산산소, 경남가스, 거제가스, 창원가스, 마산가스, 진해가스, LPG, 가스배달, 가스공급">
    <meta property="og:type" content="website">
    <meta property="og:title" content="신항만 가스 - 믿을 수 있는 가스 공급 업체">
    <meta property="og:description" content="부산, 경남 지역 최고의 가스 공급 업체. 산업용, 의료용, 특수가스, 액체가스 전문. 신속한 배달과 안전한 서비스.">
    <meta property="og:url" content="https://sinhangman-gas.onrender.com">
    <meta property="og:image" content="https://sinhangman-gas.onrender.com/images/gas-cylinder-1.jpg">
    <meta property="og:locale" content="ko_KR">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="신항만 가스 - 믿을 수 있는 가스 공급 업체">
    <meta name="twitter:description" content="부산, 경남 지역 최고의 가스 공급 업체">
    <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "신항만 가스",
      "alternateName": "신항만가스",
      "description": "부산, 경남 지역 산업용, 의료용, 특수가스, 액체가스 전문 공급업체",
      "image": "https://sinhangman-gas.onrender.com/images/gas-cylinder-1.jpg",
      "telephone": "010-5513-3481",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "을숙도대로677번길 11",
        "addressLocality": "신평동",
        "addressRegion": "사하구",
        "addressCountry": "부산광역시"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": "35.0861315",
        "longitude": "128.9790935"
      },
      "url": "https://sinhangman-gas.onrender.com",
      "openingHoursSpecification": [
        { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"], "opens": "07:30", "closes": "17:30" },
        { "@type": "OpeningHoursSpecification", "dayOfWeek": "Saturday", "opens": "07:30", "closes": "13:00" }
      ],
      "areaServed": [
        { "@type": "City", "name": "부산광역시" },
        { "@type": "AdministrativeArea", "name": "경상남도" }
      ],
      "priceRange": "$$",
      "paymentAccepted": "현금, 계좌이체",
      "currenciesAccepted": "KRW"
    }
    </script>
    <link rel="icon" type="image/png" href="/images/logo-simple.png">
    <link rel="apple-touch-icon" href="/images/logo-simple.png">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="intro-screen" id="introScreen" aria-hidden="true">
        <div class="intro-inner">
            <span class="intro-kicker">SINHANGMAN GAS</span>
            <strong>신항만 가스</strong>
            <span class="intro-line"></span>
            <p>부산·경남 가스 공급</p>
        </div>
    </div>

    <div id="main-content" class="main-content-wrapper visible">
        <Navigation />

        <main>
            <section class="hero" id="hero">
                <canvas id="heroCanvas" class="hero-canvas" aria-hidden="true"></canvas>
                <div class="hero-media" aria-hidden="true">
                    <img src="/images/gas-cylinder-1.jpg" alt="">
                </div>
                <div class="hero-content">
                    <p class="section-kicker">/ SINHANGMAN GAS</p>
                    <h1>신항만 가스</h1>
                    <p class="hero-lead">부산·경남 산업용, 의료용, 특수가스 공급</p>
                    <div class="hero-pills" aria-label="주요 취급 분야">
                        <span>산업용</span>
                        <span>의료용</span>
                        <span>특수가스</span>
                        <span>정기 배달</span>
                    </div>
                    <div class="hero-actions">
                        <a href="tel:010-5513-3481" class="btn-primary">전화 문의</a>
                        <a href="/products/" class="btn-secondary">제품 보기</a>
                    </div>
                </div>
                <div class="hero-visual" aria-hidden="true">
                    <figure class="hero-photo hero-photo-main">
                        <img src="/images/truck-1.jpeg" alt="">
                    </figure>
                    <figure class="hero-photo hero-photo-small">
                        <img src="/images/factory-1.jpeg" alt="">
                    </figure>
                    <div class="hero-status-card">
                        <span>SUPPLY AREA</span>
                        <strong>부산·경남</strong>
                        <p>산업·의료·특수가스</p>
                    </div>
                    <div class="hero-call-card">
                        <span>DIRECT CALL</span>
                        <strong>010-5513-3481</strong>
                    </div>
                </div>
                <div class="hero-bottom">
                    <p>부산 사하구 을숙도대로677번길 11</p>
                    <a href="#services">Scroll down</a>
                </div>
            </section>

            <section class="metrics-section" aria-label="핵심 정보">
                <div class="container metric-grid">
                    {metrics.map((item) => (
                        <div class="metric-item">
                            <strong>{item.value}</strong>
                            <span>{item.label}</span>
                        </div>
                    ))}
                </div>
            </section>

            <section class="services section-block" id="services">
                <div class="container split-heading">
                    <div>
                        <p class="section-kicker">/ SERVICES</p>
                        <h2>정확한 가스 공급</h2>
                    </div>
                    <p>LPG·산업용·의료용·특수가스를 상담합니다.</p>
                </div>
                <div class="container service-list linear-list">
                    {services.map(([no, title, desc]) => (
                        <article class="service-item linear-item reveal-item">
                            <span>{no}</span>
                            <h3>{title}</h3>
                            <p>{desc}</p>
                        </article>
                    ))}
                </div>
            </section>

            <section class="gallery-section section-block">
                <div class="container split-heading">
                    <div>
                        <p class="section-kicker">/ FIELD</p>
                        <h2>현장 공급 역량</h2>
                    </div>
                    <p>저장 시설과 배송 차량으로 안정적인 공급을 유지합니다.</p>
                </div>
                <div class="container editorial-gallery">
                    <figure class="gallery-feature">
                        <img src="/images/factory-1.jpeg" alt="신항만 가스 저장 시설">
                        <figcaption>가스 저장 시설</figcaption>
                    </figure>
                    <div class="gallery-stack">
                        <figure><img src="/images/truck-1.jpeg" alt="신항만 가스 배달 차량"><figcaption>배달 차량</figcaption></figure>
                        <figure><img src="/images/work-1.jpeg" alt="신항만 가스 작업 현장"><figcaption>전문 작업</figcaption></figure>
                        <figure><img src="/images/factory-3.jpeg" alt="신항만 가스 안전 시설"><figcaption>안전 관리</figcaption></figure>
                    </div>
                </div>
            </section>

            <section class="why-choose-us section-block">
                <div class="container split-heading">
                    <div>
                        <p class="section-kicker">/ ADVANTAGES</p>
                        <h2>서비스 강점</h2>
                    </div>
                </div>
                <div class="advantage-list">
                    {strengths.map(([no, title, desc]) => (
                        <article class="advantage-row reveal-item">
                            <span>{no}</span>
                            <h3>{title}</h3>
                            <p>{desc}</p>
                        </article>
                    ))}
                </div>
            </section>

            <section class="contact section-block">
                <div class="container contact-panel">
                    <p class="section-kicker">/ CONTACT</p>
                    <h2>가스 공급 문의</h2>
                    <div class="contact-info">
                        <div class="contact-item">
                            <h3>전화</h3>
                            <p><a href="tel:010-5513-3481">010-5513-3481</a></p>
                        </div>
                        <div class="contact-item">
                            <h3>주소</h3>
                            <p>부산 사하구 을숙도대로677번길 11</p>
                            <p class="address-sub">부산 사하구 신평동 568-4</p>
                        </div>
                        <div class="contact-item">
                            <h3>영업시간</h3>
                            <p>평일 07:30 - 17:30</p>
                            <p>토요일 07:30 - 13:00</p>
                        </div>
                    </div>
                    <div class="cta-buttons">
                        <a href="tel:010-5513-3481" class="btn-primary">전화 문의하기</a>
                        <a href="/location/" class="btn-secondary">오시는 길 보기</a>
                    </div>
                </div>
            </section>
        </main>

        <Footer />
    </div>

    <script src="/js/main.js" is:inline></script>
</body>
</html>
