---
import BaseLayout from '../layouts/BaseLayout.astro';

const rules = [
    ['01', '사용 전', ['인화성 물질을 가스 용기 주변에 두지 마세요', '직사광선을 피하고 통풍되는 곳에 보관하세요', '가스 용기는 반드시 세워서 보관하세요', '가스 호스는 정기적으로 교체하세요']],
    ['02', '사용 중', ['가스 사용 중에는 자리를 비우지 마세요', '파란 불꽃이 되도록 조절하세요', '끓어 넘치지 않도록 주의하세요', '환기를 자주 시켜주세요']],
    ['03', '사용 후', ['중간밸브와 용기밸브를 완전히 잠그세요', '가스레인지 주변을 깨끗이 청소하세요', '가스 누출 여부를 확인하세요', '장기 미사용 시 용기밸브를 잠그세요']],
    ['04', '정기 점검', ['가스 호스 연결 상태를 확인하세요', '가스레인지 청결 상태를 확인하세요', '비눗물 테스트로 누출 여부를 확인하세요', '용기 및 밸브 상태를 확인하세요']]
];

const emergency = ['즉시 중간밸브와 용기밸브를 잠그세요', '창문과 문을 열어 환기하세요', '전기 스위치나 전화기를 만지지 마세요', '안전한 곳에서 신항만 가스로 연락하세요', '가스 냄새가 없어질 때까지 환기하세요'];
---
<BaseLayout
    title="가스 안전수칙 - 신항만 가스 | 안전한 가스 사용법"
    description="가스 안전 사용 수칙, 가스 누출 시 대처 방법, 정기 점검 사항. 안전하게 가스를 사용하는 방법을 안내합니다."
    keywords="가스안전, 가스사용법, 가스누출대처, LPG안전, 산소가스안전, 가스점검"
    ogTitle="가스 안전수칙 - 신항만 가스"
    ogDescription="안전한 가스 사용을 위한 필수 수칙과 대처 방법"
    ogUrl="https://sinhangman-gas.onrender.com/safety"
>
    <section class="page-header">
        <div class="container">
            <p class="section-kicker">/ SAFETY</p>
            <h1>안전수칙</h1>
            <p>가스 안전 사용 수칙과 긴급 대처 방법입니다.</p>
        </div>
    </section>

    <section class="content-section">
        <div class="container safety-content">
            <div class="safety-grid">
                {rules.map(([no, title, items]) => (
                    <article class="safety-section reveal-item">
                        <span>{no}</span>
                        <h2>{title}</h2>
                        <ul class="safety-list">
                            {items.map((item) => <li>{item}</li>)}
                        </ul>
                    </article>
                ))}
            </div>

            <article class="safety-section emergency reveal-item">
                <p class="section-kicker">/ EMERGENCY</p>
                <h2>가스 누출 시 대처 방법</h2>
                <ol class="safety-list">
                    {emergency.map((item) => <li>{item}</li>)}
                </ol>
            </article>

            <div class="emergency-contact">
                <p class="section-kicker">/ CALL</p>
                <h2>긴급 연락처</h2>
                <div class="contact-grid">
                    <div class="emergency-item"><h3>신항만 가스</h3><p class="phone-large">010-5513-3481</p></div>
                    <div class="emergency-item"><h3>한국가스안전공사</h3><p class="phone-large">1544-4500</p></div>
                    <div class="emergency-item"><h3>화재 신고</h3><p class="phone-large">119</p></div>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
