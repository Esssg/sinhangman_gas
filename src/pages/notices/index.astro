---
import BaseLayout from '../../layouts/BaseLayout.astro';

const notices = [
    {
        no: '중요',
        title: '신항만 가스 홈페이지 오픈을 환영합니다!',
        href: '/notices/welcome/',
        date: '2024-01-01',
        type: '공지'
    },
    {
        no: '중요',
        title: '안전한 가스 사용 수칙 안내',
        href: '/notices/safety-guide/',
        date: '2024-01-01',
        type: '안전'
    },
    {
        no: '3',
        title: '설 명절 배송 일정 안내',
        href: '/notices/holiday-delivery/',
        date: '2024-01-01',
        type: '배송'
    }
];
---
<BaseLayout
    title="공지사항 - 신항만 가스 | 새로운 소식"
    description="신항만 가스의 새로운 소식과 공지사항을 확인하세요. 부산, 경남 지역 가스 공급 정보."
    keywords="신항만가스 공지, 부산가스 소식, 가스업체 공지사항"
    ogTitle="공지사항 - 신항만 가스"
    ogDescription="신항만 가스의 새로운 소식과 공지사항"
    ogUrl="https://sinhangman-gas.onrender.com/notices"
>
    <section class="page-header">
        <div class="container">
            <h1>공지사항</h1>
            <p>신항만 가스의 새로운 소식</p>
        </div>
    </section>

    <section class="content-section">
        <div class="container">
            <div class="notice-list">
                <table class="notice-table">
                    <thead>
                        <tr>
                            <th width="10%">번호</th>
                            <th width="50%">제목</th>
                            <th width="20%">작성일</th>
                            <th width="10%">분류</th>
                        </tr>
                    </thead>
                    <tbody>
                        {notices.map((notice) => (
                            <tr>
                                <td>
                                    {notice.no === '중요'
                                        ? <span class="badge-important">중요</span>
                                        : <span>{notice.no}</span>}
                                </td>
                                <td class="notice-title">
                                    <a href={notice.href}>{notice.title}</a>
                                </td>
                                <td>{notice.date}</td>
                                <td>{notice.type}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</BaseLayout>
